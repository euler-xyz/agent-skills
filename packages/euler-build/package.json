{
  "name": "euler-build",
  "version": "1.0.0",
  "description": "Build tooling for Euler Finance Agent Skill",
  "type": "module",
  "scripts": {
    "build": "pnpm build-agents && pnpm extract-tests",
    "build-agents": "tsx src/build.ts",
    "validate": "tsx src/validate.ts",
    "extract-tests": "tsx src/extract-tests.ts",
    "dev": "pnpm build && pnpm validate",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check-generated": "tsx src/build.ts --check && tsx src/extract-tests.ts --check",
    "test:solidity": "tsx src/check-solidity.ts"
  },
  "keywords": [
    "euler",
    "defi",
    "lending",
    "llm",
    "agents"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eulerxyz/euler-v2-sdk": "3.4.0",
    "@tanstack/query-core": "5.101.4",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "viem": "2.48.8"
  },
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "ws": "8.21.0"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
